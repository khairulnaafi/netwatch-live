{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/join", "dest": "/public/join.html" },
    { "src": "/join.js", "dest": "/public/js/join.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
